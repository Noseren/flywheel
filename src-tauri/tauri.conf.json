{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flywheel",
  "version": "0.1.0",
  "identifier": "dev.flywheel.runtime",
  "build": {
    "frontendDist": "../system-assets/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flywheel",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
